{
  "name": "dsh-download-dock",
  "version": "0.1.0",
  "type": "module",
  "description": "下载坞：在 DeepSeek Harness 界面右下角显示后台下载的实时进度卡片（字节、速度、剩余时间），覆盖 git clone / pip / npm / curl / aria2 / winget 等后台下载。",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "imnotRiv3r",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnotRiv3r/dsh-download-dock.git"
  },
  "homepage": "https://github.com/imnotRiv3r/dsh-download-dock#readme",
  "bugs": {
    "url": "https://github.com/imnotRiv3r/dsh-download-dock/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "download",
    "progress",
    "hud",
    "dock"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "test",
    "docs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/detect.js && node --check lib/sampler.js && node --check lib/tracker.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0"
  }
}
